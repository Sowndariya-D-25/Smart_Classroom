# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/smart-classroom
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-classroom
MONGO_URI=mongodb://127.0.0.1:27017/smart-classroom

# Long, random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Default low-attendance warning threshold (percent)
LOW_ATTENDANCE_THRESHOLD=75

# Maximum face-descriptor distance (face-api.js) still considered a
# match. Lower = stricter (fewer false matches, more "not recognized").
# Production-tuned default: 0.50
FACE_MATCH_THRESHOLD=0.50

# Minimum Euclidean distance margin required between the best candidate
# and the second-best candidate to reject ambiguous impostor matches.
FACE_MARGIN_THRESHOLD=0.08

